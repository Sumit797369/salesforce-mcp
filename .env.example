# Server Configuration
PORT=3000
NODE_ENV=development
DATA_SOURCE=salesforce
TRANSPORT=sse
# Options: sse, streamable_http, stdio

# Default Business Logic Settings
DEFAULT_INACTIVITY_DAYS=60

# Salesforce Developer Edition Configuration (Optional - only required if DATA_SOURCE=salesforce)
# Never commit real credentials to version control.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=your_connected_app_or_external_client_app_client_id
SALESFORCE_CLIENT_SECRET=your_client_secret
SALESFORCE_USERNAME=your_salesforce_developer_username
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_security_token_if_required

# Advanced Salesforce OAuth (Authorization Code / Refresh Token Flow - Optional)
SALESFORCE_REDIRECT_URI=http://localhost:3000/oauth/callback
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_INSTANCE_URL=

# Configurable Salesforce Object & Field Mappings (Optional overrides)
# Defaults map to standard Account & Order objects
SF_OBJECT_CUSTOMER=Account
SF_FIELD_CUSTOMER_ID=Id
SF_FIELD_CUSTOMER_NAME=Name
SF_FIELD_OUTSTANDING_BALANCE=Outstanding_Balance__c
SF_FIELD_DUE_DATE=Payment_Due_Date__c
SF_FIELD_LAST_ORDER_DATE=Last_Order_Date__c
SF_FIELD_TOTAL_ORDERS=Total_Orders__c
